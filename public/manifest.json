{
  "id": "/",
  "name": "Weather Pro - Advanced Weather Intelligence",
  "short_name": "Weather Pro",
  "description": "Weather for four audiences — general, marine, mountain and agricultural — with threshold alerts, historical comparison and offline access to forecasts you have already viewed.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#0ea5e9",
  "lang": "en",
  "dir": "ltr",
  "categories": ["weather", "navigation", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/icons/weather-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/weather-icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "General weather",
      "short_name": "General",
      "description": "Forecast for the general public",
      "url": "/?profile=general",
      "icons": [
        {
          "src": "/icons/weather-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Marine weather",
      "short_name": "Marine",
      "description": "Sea state, waves and whether to go out",
      "url": "/?profile=marine",
      "icons": [
        {
          "src": "/icons/weather-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Mountain weather",
      "short_name": "Mountain",
      "description": "Ascent planning, wind and exposure",
      "url": "/?profile=mountain",
      "icons": [
        {
          "src": "/icons/weather-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Agricultural weather",
      "short_name": "Agriculture",
      "description": "Soil, frost and irrigation",
      "url": "/?profile=agriculture",
      "icons": [
        {
          "src": "/icons/weather-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  }
}
